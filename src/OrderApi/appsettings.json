{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Inventory": {
    "BaseAddress": "http://127.0.0.1:5080/",
    "TimeoutSeconds": 10,
    "HandlerLifetimeSeconds": 120,
    "PooledConnectionLifetimeSeconds": 120
  },
  "DnsSimulation": {
    "Enabled": true,
    "LogicalHost": "inventory.local",
    "InitialBaseAddress": "http://127.0.0.1:5080/",
    "PooledConnectionLifetimeSeconds": 10,
    "TimeoutSeconds": 10
  }
}
